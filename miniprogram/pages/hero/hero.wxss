.hero-page{position:relative;box-sizing:border-box;min-height:100vh;padding:92rpx 46rpx 84rpx;overflow:hidden;background:radial-gradient(circle at 50% 40%,#24261f 0,#090a08 48%,#020302 100%);color:#eff1e9}.top{display:flex;justify-content:space-between;color:#969d91;font-size:18rpx;letter-spacing:2rpx}.film-camera{position:absolute;z-index:2;left:50%;top:42%;width:680rpx;height:500rpx;transform:translate(-50%,-50%)}.copy{position:absolute;left:46rpx;bottom:220rpx;display:flex;flex-direction:column;gap:14rpx}.copy text{font-size:18rpx;color:#aeb4a7;letter-spacing:2rpx}.copy view{font-size:52rpx;font-weight:700;line-height:1.16;letter-spacing:-2rpx}.shutter{position:absolute;z-index:3;left:50%;bottom:86rpx;width:114rpx;height:114rpx;transform:translateX(-50%);box-sizing:border-box;padding:10rpx;border:2rpx solid #b6b7ac;border-radius:50%;background:#171916}.shutter view{width:100%;height:100%;border-radius:50%;background:#dff33b;box-shadow:0 0 34rpx rgba(223,243,59,.34)}.flash{position:fixed;z-index:10;inset:0;background:#f5ffdf;opacity:0;pointer-events:none}.flash.on{animation:flash .52s ease-out}@keyframes flash{0%{opacity:1}18%{opacity:.92}100%{opacity:0}}
