.page{min-height:100vh;padding:52rpx 32rpx 110rpx;background:#070907}.intro{display:flex;justify-content:space-between;align-items:center}.kicker{font-size:20rpx;color:#8e9287;letter-spacing:2rpx}.title{font-size:58rpx;line-height:1.16;font-weight:700;letter-spacing:-2rpx;margin:18rpx 0 50rpx}.head{display:flex;justify-content:space-between;align-items:center;font-size:20rpx;margin-bottom:20rpx}.rename{color:#dff33b}.rolls{white-space:nowrap;width:calc(100vw - 64rpx)}.roll{display:inline-block;position:relative;width:520rpx;height:290rpx;margin-right:16rpx;overflow:hidden;border:1rpx solid #303630;border-radius:24rpx}.roll.selected{border-color:#b7ca49;box-shadow:0 0 0 2rpx rgba(183,202,73,.12)}.roll image,.shade{position:absolute;width:100%;height:100%;left:0;top:0}.shade{background:linear-gradient(90deg,rgba(0,0,0,.78),rgba(0,0,0,.1))}.roll-text{position:absolute;left:26rpx;bottom:26rpx;display:flex;flex-direction:column;gap:8rpx}.roll-text text:last-child{font-size:52rpx;font-weight:700}.roll-text .mono{font-size:18rpx}.note{margin-top:54rpx;border-top:1rpx solid #252a24;padding-top:26rpx;display:flex;flex-direction:column;gap:12rpx}.note .range{color:#8f958a}.note view{font-size:42rpx;font-weight:700;margin-top:4rpx}.note .muted{font-size:26rpx;color:#969b90}
