.page{min-height:100vh;padding:52rpx 32rpx 120rpx;background:#070907}.album-head{display:flex;justify-content:space-between;align-items:center}.eyebrow{font-size:20rpx;color:#92978d;letter-spacing:2rpx}.tip{padding:18rpx 20rpx;margin:22rpx 0 32rpx;border-left:2rpx solid #dff33b;color:#989d93;font-size:22rpx}.photo-grid{display:flex;flex-wrap:wrap;gap:14rpx}.photo{position:relative;flex:0 0 210rpx;width:210rpx;height:210rpx;box-sizing:border-box;overflow:hidden;border:1rpx solid #303630;border-radius:18rpx;background:#111}.photo.dragging{transform:scale(.94);opacity:.62;border-color:#dff33b}.photo image{width:100%;height:100%}.order,.more{position:absolute;top:10rpx;color:#fff;font-size:19rpx;line-height:36rpx;text-align:center;background:rgba(0,0,0,.62);border-radius:999rpx}.order{left:10rpx;min-width:36rpx}.more{right:10rpx;min-width:46rpx;font-size:23rpx}.add-photo{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10rpx;border-style:dashed;border-color:#586151;background:#0c0f0d}.add-photo text{font-size:48rpx;line-height:1;color:#dff33b}.add-photo small{font-size:20rpx;color:#989d93}.body,.body-editor{box-sizing:border-box;width:100%;margin-top:42rpx;padding-top:26rpx;border-top:1rpx solid #252a24;color:#d7dad0;font-size:29rpx;line-height:1.6}.body-editor{height:240rpx;padding:24rpx;border:1rpx solid #303630;border-radius:18rpx;background:#0d100e}.edit-link{margin-top:26rpx;color:#757b70;font-size:22rpx;letter-spacing:1rpx}.save{margin-top:28rpx;width:100%;padding:26rpx;border-radius:18rpx;font-size:28rpx}.delete-entry{margin:50rpx 0 20rpx;text-align:center;color:#676e63;font-size:22rpx;letter-spacing:1rpx}
