.page{min-height:100vh;padding:44rpx 32rpx 106rpx;background:radial-gradient(circle at 88% 4%,#182012 0,#070907 42%)}.eyebrow,.label{font-size:20rpx;color:#91958a;letter-spacing:2rpx}.title{font-size:58rpx;line-height:1.16;font-weight:700;letter-spacing:-2rpx;margin:14rpx 0 32rpx}.camera{height:260rpx;border:2rpx dashed #56604f;border-radius:26rpx;background:#0b0e0b;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:10rpx}.camera:active{background:#141a10;border-color:#dff33b}.camera text{font-size:60rpx;line-height:1;color:#dff33b}.camera view{font-size:28rpx;font-weight:600}.camera small{font-size:20rpx;color:#91958a}.photos{white-space:nowrap;margin:16rpx 0}.photo{position:relative;width:168rpx;height:168rpx;display:inline-block;margin-right:12rpx;overflow:hidden;border-radius:18rpx;border:1rpx solid #3a4036}.photo image{width:100%;height:100%}.photo text{position:absolute;right:8rpx;top:8rpx;min-width:40rpx;text-align:center;background:rgba(0,0,0,.62);border-radius:999rpx;color:white;padding:4rpx 10rpx}.input,.body{box-sizing:border-box;width:100%;background:#0d100e;border:1rpx solid #303630;border-radius:18rpx;color:#f0f0e6;padding:0 22rpx;font-size:26rpx}.input{height:78rpx;line-height:78rpx;margin-top:14rpx}.body{height:180rpx;line-height:1.55;padding:20rpx 22rpx;margin-top:16rpx}.input:focus,.body:focus{border-color:#9daf46;background:#11150e}.label{margin-top:26rpx}.tags{display:flex;flex-wrap:wrap;gap:10rpx;margin:14rpx 0 2rpx}.tag{margin:0;padding:11rpx 18rpx;line-height:1.1;border-radius:999rpx;background:#0d100e;border:1rpx solid #343a32;color:#c8cbbf;font-size:22rpx}.tag.active{background:#dff33b;color:#111408;border-color:#dff33b;font-weight:700}.optional{margin-top:16rpx;color:#a9af9f;font-size:22rpx}.publish{margin-top:28rpx;width:100%;padding:24rpx;font-size:27rpx;letter-spacing:1rpx;border-radius:18rpx;box-shadow:0 12rpx 34rpx rgba(0,0,0,.28)}
