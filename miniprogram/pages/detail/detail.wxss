.page{min-height:100vh;padding-bottom:100rpx;background:#070907}.cover{width:100%;height:480rpx;filter:brightness(.58)}.hero{margin:-145rpx 32rpx 0;position:relative;display:flex;flex-direction:column;gap:12rpx}.hero .location-line,.hero .range-line,.label{font-size:20rpx;color:#c8cbbf;letter-spacing:2rpx}.hero .range-line{color:#90968a}.hero view{font-size:62rpx;font-weight:700;letter-spacing:-2rpx;margin-top:8rpx}.hero>text:last-child{font-size:27rpx;line-height:1.6;color:#b0b3aa}.label{margin:74rpx 32rpx 18rpx}.entry{margin:0 32rpx;padding:28rpx 0 32rpx;border-top:1rpx solid #242923;display:flex;flex-direction:column;gap:16rpx}.time{font-size:20rpx;letter-spacing:1rpx;color:#8d9288}.entry-body{font-size:32rpx;line-height:1.55;color:#f0f0e6}.photo-stack{position:relative;width:100%;height:380rpx;margin-top:8rpx}.back-card{position:absolute;right:14rpx;bottom:18rpx;width:80%;height:330rpx;border:1rpx solid #3b4238;border-radius:24rpx;background:#171b16}.back-one{transform:rotate(3deg);opacity:.72}.back-two{right:0;bottom:32rpx;transform:rotate(6deg);opacity:.42}.fold-swiper{position:relative;z-index:3;width:100%;height:360rpx}.fold-swiper swiper-item{box-sizing:border-box;padding:0 8rpx}.fold-photo{width:100%;height:100%;border-radius:24rpx;border:1rpx solid rgba(255,255,255,.14);box-shadow:0 16rpx 38rpx rgba(0,0,0,.35)}.photo-count{position:absolute;right:22rpx;bottom:24rpx;z-index:6;min-width:58rpx;height:50rpx;line-height:50rpx;text-align:center;border-radius:999rpx;background:rgba(5,6,5,.78);color:#fff;font-size:22rpx}.entry-tags{display:flex;flex-wrap:wrap;gap:12rpx}.entry-tags text{font-size:21rpx;color:#9ca28f}
