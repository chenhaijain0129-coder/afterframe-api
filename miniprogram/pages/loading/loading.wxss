.loading-page{position:relative;box-sizing:border-box;min-height:100vh;padding:96rpx 48rpx;overflow:hidden;background:#080a08;color:#eff1e9}.loading-copy{position:absolute;left:48rpx;bottom:260rpx;display:flex;flex-direction:column;gap:22rpx}.loading-copy text{font-size:19rpx;letter-spacing:3rpx;color:#9fa69a}.loading-copy view{font-size:58rpx;line-height:1.14;font-weight:700;letter-spacing:-2rpx}.progress{position:absolute;left:48rpx;right:48rpx;bottom:182rpx;height:5rpx;background:#242a23}.progress view{height:100%;background:#dff33b;transition:width .09s linear}.sprocket{position:absolute;left:0;right:0;display:flex;justify-content:space-around}.sprocket.top{top:34rpx}.sprocket.bottom{bottom:34rpx}.sprocket i{display:block;width:74rpx;height:26rpx;background:#1c211b;animation:advance .5s linear infinite}@keyframes advance{from{transform:translateX(0)}to{transform:translateX(-18rpx)}}
