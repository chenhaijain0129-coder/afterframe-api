.page{min-height:100vh;padding:52rpx 32rpx 130rpx;background:#070907}.eyebrow,.label{font-size:20rpx;color:#91958a;letter-spacing:2rpx}.title{font-size:58rpx;line-height:1.16;font-weight:700;letter-spacing:-2rpx;margin:18rpx 0 50rpx}.selector{white-space:nowrap;border-bottom:1rpx solid #252a24;padding-bottom:24rpx}.archive{display:inline-block;color:#aeb2a7;padding:14rpx 24rpx;border:1rpx solid #303630;border-radius:999rpx;margin-right:12rpx}.archive.active{background:#dff33b;border-color:#dff33b;color:#101408;font-weight:700}.form{margin-top:44rpx}.label{margin:30rpx 0 14rpx}.form input,.form textarea{box-sizing:border-box;width:100%;background:#0d100e;border:1rpx solid #303630;border-radius:18rpx;color:#f0f0e6;font-size:28rpx;padding:0 24rpx;height:90rpx;line-height:90rpx}.date-row{display:flex;gap:22rpx}.date-row picker{box-sizing:border-box;flex:1;min-width:0;height:118rpx;background:#0d100e;border:1rpx solid #303630;border-radius:18rpx;padding:18rpx 20rpx}.date-row picker view{height:100%;display:flex;flex-direction:column;justify-content:center;gap:8rpx;font-size:30rpx}.date-caption{font-size:19rpx;color:#91958a;letter-spacing:2rpx}.hint{margin-top:12rpx;color:#777d72;font-size:20rpx}.location{box-sizing:border-box;display:flex;justify-content:space-between;align-items:center;width:100%;min-height:96rpx;padding:18rpx 22rpx;background:#0d100e;border:1rpx solid #303630;border-radius:18rpx;color:#f0f0e6;font-size:28rpx}.location>view{display:flex;min-width:0;flex:1;flex-direction:column;gap:6rpx}.address{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#8c9186;font-size:20rpx}.pin{margin-left:18rpx;color:#dff33b;font-size:22rpx;white-space:nowrap}.form textarea{height:210rpx;line-height:1.6;padding:20rpx 24rpx}.save{margin-top:44rpx;width:100%;padding:26rpx;font-size:28rpx;border-radius:18rpx}.delete-archive{margin:48rpx 0 20rpx;text-align:center;color:#666d62;font-size:22rpx;letter-spacing:1rpx}
